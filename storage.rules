rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Payment evidence lives under evidence/{parentUid}/{submissionId}/...
    // Only the owning parent (at upload) and admins can read it.
    // Public download links are not used.
    match /evidence/{parentUid}/{allPaths=**} {
      allow create: if request.auth != null
        && request.auth.uid == parentUid
        && request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/(jpeg|png|webp)'));
      allow read: if request.auth != null
        && (request.auth.uid == parentUid || isAdmin());
      allow update, delete: if false;
    }

    // Receipts PDFs are generated in the browser and downloaded directly; they are not stored here.

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
